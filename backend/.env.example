# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=postgres
PGSCHEMA=lms

# JWT (HS256 for local dev — see README for rationale)
JWT_SECRET=change_this_to_a_long_random_string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# PII encryption key used with fn_encrypt_lead_pii / fn_decrypt_lead_pii (pgcrypto AES-256).
# Must be a strong secret kept out of source control / SQL. NOTE: if you load the demo seed data
# from lms_saas_schema_v_1.2.sql as-is, its seed leads were encrypted with the literal key
# 'CHANGE_ME_AT_DEPLOY_32B_KEY' (see SECTION 13 of that script) - use that same value here, or the
# existing demo leads will fail to decrypt. Re-encrypt the seed data with your own key for real use.
LMS_PII_ENC_KEY=CHANGE_ME_AT_DEPLOY_32B_KEY

# Platform Admin login is mobile + OTP for any active user whose role is 'platformadmin'
# (see backend/sql/seed_platform_admin.sql to seed one). The OTP is printed to this server's
# console in dev mode - there is no password/env var to configure.

# CORS - frontend dev server origin
CORS_ORIGIN=http://localhost:5174

# Server
PORT=4000
NODE_ENV=development
